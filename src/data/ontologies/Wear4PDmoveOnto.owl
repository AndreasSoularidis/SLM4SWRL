    <rdf:Description>
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
        <rdfs:comment>If a patient with Parkinson’s disease has a falling event observation and that observation happened 30 minutes after dosing, then send a notification alert to the doctor.</rdfs:comment>
