<rdf:RDF xmlns="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#"
     xml:base="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP"
     xmlns:FWP="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP">
        <terms:abstract xml:lang="en">To provide a structured, machine-readable representation of kurtosis, signal entropy, and smoothness and their associated fuzzy categories for investigating healthy and Parkinsonian patterns.</terms:abstract>
        <terms:creator>Adam Koletis</terms:creator>
        <terms:description xml:lang="en">An ontology for representing individuals, measurements, and fuzzy feature categories based on kurtosis, signal entropy, and smoothness. It includes healthy-status and Parkinsonian-severity categories, fuzzy OWL annotations, and SWRL rules.</terms:description>
        <terms:language>en</terms:language>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-08</terms:modified>
        <terms:subject xml:lang="en">Fuzzy ontologies; measurement features; Parkinsonian patterns</terms:subject>
        <terms:title xml:lang="en">FWP — Fuzzy Wave Feature Ontology</terms:title>
        <vann:preferredNamespacePrefix>FWP</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#"/>
        <rdfs:comment xml:lang="en">Metadata-enriched documentation copy. Aim and description summarize the vocabulary and rules in the supplied file. No owl:imports declarations are present. No additional contributors were supplied.</rdfs:comment>
    </owl:Ontology>
    


