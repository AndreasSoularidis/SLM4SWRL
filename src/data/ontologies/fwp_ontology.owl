    <!-- http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#Healthy -->


    <owl:Class rdf:about="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#Healthy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#Individuals"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#HealthyStatusHigh -->


    <owl:Class rdf:about="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#HealthyStatusHigh">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#Healthy"/>
