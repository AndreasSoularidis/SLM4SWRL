    <!-- http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#Individuals -->


    <owl:Class rdf:about="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#Individuals"/>
    


    <!-- http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#KurtosisHigh -->


    <owl:Class rdf:about="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#KurtosisHigh">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#hasKurtosis"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#FuzzyKurtosisHigh"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#Measurement"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#KurtosisLow -->


    <owl:Class rdf:about="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#KurtosisLow">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#hasKurtosis"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#FuzzyKurtosisLow"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/adklts/ontologies/2025/3/FWP#Measurement"/>
