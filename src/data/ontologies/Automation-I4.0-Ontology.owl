    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/i40/sto#hasStabilityDate -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/i40/sto#hasStabilityDate">
        <rdfs:domain rdf:resource="https://w3id.org/i40/sto#Publication"/>
