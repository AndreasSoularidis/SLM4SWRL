        <rdfs:label xml:lang="en">has Edition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/i40/sto#hasImplementationFormat -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/i40/sto#hasImplementationFormat">
