    <!-- http://example.org/iira#CrosscuttingFunction -->

    <owl:Class rdf:about="http://example.org/iira#CrosscuttingFunction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/i40/sto#StandardClassification"/>
        <terms:creator xml:lang="en">sebastian</terms:creator>
        <rdfs:comment xml:lang="en">Often these enabling functions, the so-called crosscutting functions, need to be made available across many of the system functional components. For Reference Architecture 6: Functional Viewpoint example, system functions need to be connected so they can interact with each other to complete functionality at the system level.</rdfs:comment>
        <rdfs:label xml:lang="en">IIRA Crosscutting Function</rdfs:label>
    </owl:Class>
    


