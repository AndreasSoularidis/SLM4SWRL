    <owl:Ontology rdf:about="http://www.semanticweb.org/santiago/Automation-I4.0-Ontology">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/santiago/Automation-I4.0-Ontology/2.0.0"/>
        <terms:contributor rdf:resource="https://www.linkedin.com/in/sebastianrbader/"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-01-25</terms:created>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-10-31</terms:created>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-09-08</terms:modified>
        <terms:publisher rdf:resource="http://de.dbpedia.org/resource/Fraunhofer-Gesellschaft"/>
        <terms:publisher rdf:resource="https://github.com/sagilar"/>
        <terms:rights xml:lang="en">This work is distributed under a Creative Commons Attribution License (http://creativecommons.org/licenses/by/3.0/).</terms:rights>
        <terms:rights xml:lang="en">This work is distributed under an Apache License 2.0 (http://www.apache.org/licenses/).</terms:rights>
        <terms:title xml:lang="en">Standards Ontology</terms:title>
        <vann:preferredNamespacePrefix>Automation-I4.0-Core-Ontology</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>ddo</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>minified-sto</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>rami</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>sto</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/i40/rami#</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri>https://w3id.org/i40/sto#</vann:preferredNamespaceUri>
        <void:vocabulary rdf:resource="http://purl.org/dc/elements/1.1/"/>
        <void:vocabulary rdf:resource="http://www.w3.org/2000/01/rdf-schema#"/>
        <void:vocabulary rdf:resource="http://www.w3.org/2001/XMLSchema#"/>
        <void:vocabulary rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <doap:repository rdf:resource="https://github.com/sagilar"/>
        <doap:repository rdf:resource="https://github.com/i40-Tools/StandardsOntology"/>
        <rdfs:comment xml:lang="en">An ontology to describe standards related to Industry 4.0 and Smart Manufacturing</rdfs:comment>
        <rdfs:comment xml:lang="en">The core ontology for automation systems related to the Industry 4.0 and Smart Manufacturing</rdfs:comment>
        <rdfs:comment xml:lang="en">The ontology to represent a minified version of standards to integrate the ontology for automation systems in I4.0 and the STO by Grangel et al</rdfs:comment>
        <rdfs:comment xml:lang="en">The ontology to represent discrete dynamics in automation systems related to the Industry 4.0 and Smart Manufacturing</rdfs:comment>
        <rdfs:comment>Update implementing the specifiations coming from &apos;Details of the Asset Administration Shell - Part 1: The exchange of information between partners in the value chain of Industrie 4.0 (Version 1.0)&apos;</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/i40/rami#"/>
        <owl:versionInfo>0.3</owl:versionInfo>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</owl:versionInfo>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</owl:versionInfo>
        <skos:definition xml:lang="en">An Ontology to represents the Reference Architecture Model for Industry 4.0 (RAMI), including the concept of the Administration Shell I4.0 Component.</skos:definition>
        <skos:prefLabel xml:lang="en">rami</skos:prefLabel>
        <sto:hasOfficialResource rdf:resource="https://webstore.iec.ch/publication/153"/>
    </owl:Ontology>
    


